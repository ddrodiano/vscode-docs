// Main App Component
const App = () => {
  const [sourceProduct, setSourceProduct] = useState('symantec');
  const [scope, setScope] = useState('pilot');
  const [migrationComplexity, setMigrationComplexity] = useState('standard');
  const [automation, setAutomation] = useState('none');

  const [estimatedHours, setEstimatedHours] = useState(0);

  // Constants for effort estimation
  const BASE_EFFORT = 20; // Initial planning, discovery, and tenant setup
  const EFFORT_MODIFIERS = {
    sourceProduct: {
      'symantec': 15, // Symantec agent uninstallation can be complex
      'tanium': 25, // Requires understanding Tanium's unique architecture
      'trellix': 15, // Trellix (McAfee) agents can have various dependencies
      'mcafee_epo': 15, // Migration from McAfee's management platform
    },
    scope: {
      'pilot': 0, // Baseline test deployment
      'small-business': 20, // Up to 50 devices
      'medium-enterprise': 40, // 51-250 devices
      'large-enterprise': 80, // 250+ devices, requires careful phased rollout
    },
    migrationComplexity: {
      'standard': 0, // Standard policy translation and basic agent removal
      'extensive-policy-translation': 20, // Rebuilding complex policies and rules in Defender
      'special-case-troubleshooting': 30, // Dealing with non-standard OSes or custom applications
    },
    automation: {
      'none': 0, // Manual execution of migration scripts
      'scripted-removal': 15, // Using a pre-built or custom script for uninstallation
      'full-automation': 40, // Integrating with tools like Intune for a fully automated process
    }
  };

  useEffect(() => {
    calculateEffort();
  }, [sourceProduct, scope, migrationComplexity, automation]);

  const calculateEffort = () => {
    let totalHours = BASE_EFFORT;

    // Add hours based on the source product
    totalHours += EFFORT_MODIFIERS.sourceProduct[sourceProduct];

    // Add hours based on the scope
    totalHours += EFFORT_MODIFIERS.scope[scope];

    // Add hours based on migration complexity
    totalHours += EFFORT_MODIFIERS.migrationComplexity[migrationComplexity];

    // Add hours based on automation requirements
    totalHours += EFFORT_MODIFIERS.automation[automation];

    setEstimatedHours(totalHours);
  };

  return (
    <div className="min-h-screen bg-gray-50 dark:bg-gray-900 text-gray-900 dark:text-white font-inter p-4 sm:p-8">
      <div className="max-w-4xl mx-auto bg-white dark:bg-gray-800 shadow-xl rounded-2xl p-6 sm:p-10">
        <header className="mb-8 text-center">
          <h1 className="text-3xl sm:text-4xl font-bold text-blue-700 dark:text-blue-400">Migration to Defender for Endpoint Estimator</h1>
          <p className="mt-2 text-lg text-gray-600 dark:text-gray-300">
            Estimate the hours needed to migrate from a legacy solution.
          </p>
        </header>

        <section className="space-y-8">
          {/* Source Product Section */}
          <div className="bg-gray-100 dark:bg-gray-700 p-6 rounded-xl border border-gray-200 dark:border-gray-600">
