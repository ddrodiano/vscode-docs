              <Database /> Source Product
            </h2>
            <p className="text-gray-700 dark:text-gray-300 mb-4">
              Which legacy endpoint protection solution are you migrating from?
            </p>
            <div className="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <label className={`p-4 rounded-xl cursor-pointer transition-all duration-200 ${sourceProduct === 'symantec' ? 'bg-blue-100 dark:bg-blue-800 ring-2 ring-blue-500' : 'bg-white dark:bg-gray-600 hover:bg-gray-100 dark:hover:bg-gray-500'}`}>
                <input type="radio" name="sourceProduct" value="symantec" checked={sourceProduct === 'symantec'} onChange={e => setSourceProduct(e.target.value)} className="hidden" />
                <div className="font-medium">Symantec Endpoint Protection</div>
                <div className="text-sm text-gray-500 dark:text-gray-400">Requires specific tools and careful uninstallation.</div>
              </label>
              <label className={`p-4 rounded-xl cursor-pointer transition-all duration-200 ${sourceProduct === 'tanium' ? 'bg-blue-100 dark:bg-blue-800 ring-2 ring-blue-500' : 'bg-white dark:bg-gray-600 hover:bg-gray-100 dark:hover:bg-gray-500'}`}>
                <input type="radio" name="sourceProduct" value="tanium" checked={sourceProduct === 'tanium'} onChange={e => setSourceProduct(e.target.value)} className="hidden" />
                <div className="font-medium">Tanium</div>
                <div className="text-sm text-gray-500 dark:text-gray-400">A full platform requiring a strategic migration plan.</div>
              </label>
              <label className={`p-4 rounded-xl cursor-pointer transition-all duration-200 ${sourceProduct === 'trellix' ? 'bg-blue-100 dark:bg-blue-800 ring-2 ring-blue-500' : 'bg-white dark:bg-gray-600 hover:bg-gray-100 dark:hover:bg-gray-500'}`}>
                <input type="radio" name="sourceProduct" value="trellix" checked={sourceProduct === 'trellix'} onChange={e => setSourceProduct(e.target.value)} className="hidden" />
                <div className="font-medium">Trellix (formerly McAfee)</div>
                <div className="text-sm text-gray-500 dark:text-gray-400">Often involves multiple modules and complex agent removal.</div>
              </label>
              <label className={`p-4 rounded-xl cursor-pointer transition-all duration-200 ${sourceProduct === 'mcafee_epo' ? 'bg-blue-100 dark:bg-blue-800 ring-2 ring-blue-500' : 'bg-white dark:bg-gray-600 hover:bg-gray-100 dark:hover:bg-gray-500'}`}>
                <input type="radio" name="sourceProduct" value="mcafee_epo" checked={sourceProduct === 'mcafee_epo'} onChange={e => setSourceProduct(e.target.value)} className="hidden" />
                <div className="font-medium">McAfee ePolicy Orchestrator</div>
                <div className="text-sm text-gray-500 dark:text-gray-400">Migration from this platform's managed agents.</div>
              </label>
            </div>
          </div>

          {/* Deployment Scope Section */}
          <div className="bg-gray-100 dark:bg-gray-700 p-6 rounded-xl border border-gray-200 dark:border-gray-600">
            <h2 className="text-xl sm:text-2xl font-semibold flex items-center gap-2 mb-4 text-blue-700 dark:text-blue-400">
              <Globe /> Migration Scope
            </h2>
            <p className="text-gray-700 dark:text-gray-300 mb-4">
              Select the size of the environment to be migrated.
            </p>
            <div className="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <label className={`p-4 rounded-xl cursor-pointer transition-all duration-200 ${scope === 'pilot' ? 'bg-blue-100 dark:bg-blue-800 ring-2 ring-blue-500' : 'bg-white dark:bg-gray-600 hover:bg-gray-100 dark:hover:bg-gray-500'}`}>
                <input type="radio" name="scope" value="pilot" checked={scope === 'pilot'} onChange={e => setScope(e.target.value)} className="hidden" />
                <div className="font-medium">Pilot Group (up to 25 devices)</div>
                <div className="text-sm text-gray-500 dark:text-gray-400">A small, controlled test deployment.</div>
              </label>
              <label className={`p-4 rounded-xl cursor-pointer transition-all duration-200 ${scope === 'small-business' ? 'bg-blue-100 dark:bg-blue-800 ring-2 ring-blue-500' : 'bg-white dark:bg-gray-600 hover:bg-gray-100 dark:hover:bg-gray-500'}`}>
                <input type="radio" name="scope" value="small-business" checked={scope === 'small-business'} onChange={e => setScope(e.target.value)} className="hidden" />
                <div className="font-medium">Small Business (26-250 devices)</div>
                <div className="text-sm text-gray-500 dark:text-gray-400">A full-scale rollout for a small to medium-sized organization.</div>
              </label>
              <label className={`p-4 rounded-xl cursor-pointer transition-all duration-200 ${scope === 'medium-enterprise' ? 'bg-blue-100 dark:bg-blue-800 ring-2 ring-blue-500' : 'bg-white dark:bg-gray-600 hover:bg-gray-100 dark:hover:bg-gray-500'}`}>
                <input type="radio" name="scope" value="medium-enterprise" checked={scope === 'medium-enterprise'} onChange={e => setScope(e.target.value)} className="hidden" />
                <div className="font-medium">Medium Enterprise (251-1,000 devices)</div>
                <div className="text-sm text-gray-500 dark:text-gray-400">Phased rollout with significant planning.</div>
              </label>
              <label className={`p-4 rounded-xl cursor-pointer transition-all duration-200 ${scope === 'large-enterprise' ? 'bg-blue-100 dark:bg-blue-800 ring-2 ring-blue-500' : 'bg-white dark:bg-gray-600 hover:bg-gray-100 dark:hover:bg-gray-500'}`}>
                <input type="radio" name="scope" value="large-enterprise" checked={scope === 'large-enterprise'} onChange={e => setScope(e.target.value)} className="hidden" />
                <div className="font-medium">Large Enterprise (1,001+ devices)</div>
                <div className="text-sm text-gray-500 dark:text-gray-400">Large-scale, multi-stage deployment with extensive coordination.</div>
              </label>
            </div>
          </div>

          {/* Migration Complexity Section */}
          <div className="bg-gray-100 dark:bg-gray-700 p-6 rounded-xl border border-gray-200 dark:border-gray-600">
