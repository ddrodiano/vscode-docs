              <Code /> Migration Complexity
            </h2>
            <p className="text-gray-700 dark:text-gray-300 mb-4">
              What level of complexity is involved in the migration process?
            </p>
            <div className="grid grid-cols-1 sm:grid-cols-3 gap-4">
              <label className={`p-4 rounded-xl cursor-pointer transition-all duration-200 ${migrationComplexity === 'standard' ? 'bg-blue-100 dark:bg-blue-800 ring-2 ring-blue-500' : 'bg-white dark:bg-gray-600 hover:bg-gray-100 dark:hover:bg-gray-500'}`}>
                <input type="radio" name="migrationComplexity" value="standard" checked={migrationComplexity === 'standard'} onChange={e => setMigrationComplexity(e.target.value)} className="hidden" />
                <div className="font-medium">Standard</div>
                <div className="text-sm text-gray-500 dark:text-gray-400">Default agent removal with simple policy translation.</div>
              </label>
              <label className={`p-4 rounded-xl cursor-pointer transition-all duration-200 ${migrationComplexity === 'extensive-policy-translation' ? 'bg-blue-100 dark:bg-blue-800 ring-2 ring-blue-500' : 'bg-white dark:bg-gray-600 hover:bg-gray-100 dark:hover:bg-gray-500'}`}>
                <input type="radio" name="migrationComplexity" value="extensive-policy-translation" checked={migrationComplexity === 'extensive-policy-translation'} onChange={e => setMigrationComplexity(e.target.value)} className="hidden" />
                <div className="font-medium">Extensive Policy Translation</div>
                <div className="text-sm text-gray-500 dark:text-gray-400">Recreating complex firewall or security policies.</div>
              </label>
              <label className={`p-4 rounded-xl cursor-pointer transition-all duration-200 ${migrationComplexity === 'special-case-troubleshooting' ? 'bg-blue-100 dark:bg-blue-800 ring-2 ring-blue-500' : 'bg-white dark:bg-gray-600 hover:bg-gray-100 dark:hover:bg-gray-500'}`}>
                <input type="radio" name="migrationComplexity" value="special-case-troubleshooting" checked={migrationComplexity === 'special-case-troubleshooting'} onChange={e => setMigrationComplexity(e.target.value)} className="hidden" />
                <div className="font-medium">Special Case Troubleshooting</div>
                <div className="text-sm text-gray-500 dark:text-gray-400">Dealing with compatibility issues or non-standard deployments.</div>
              </label>
            </div>
          </div>

          {/* Automation Section */}
          <div className="bg-gray-100 dark:bg-gray-700 p-6 rounded-xl border border-gray-200 dark:border-gray-600">
            <h2 className="text-xl sm:text-2xl font-semibold flex items-center gap-2 mb-4 text-blue-700 dark:text-blue-400">
              <CheckCircle /> Automation Level
            </h2>
            <p className="text-gray-700 dark:text-gray-300 mb-4">
              What level of automation will be used for the migration?
            </p>
            <div className="grid grid-cols-1 sm:grid-cols-3 gap-4">
              <label className={`p-4 rounded-xl cursor-pointer transition-all duration-200 ${automation === 'none' ? 'bg-blue-100 dark:bg-blue-800 ring-2 ring-blue-500' : 'bg-white dark:bg-gray-600 hover:bg-gray-100 dark:hover:bg-gray-500'}`}>
                <input type="radio" name="automation" value="none" checked={automation === 'none'} onChange={e => setAutomation(e.target.value)} className="hidden" />
                <div className="font-medium">None / Manual</div>
                <div className="text-sm text-gray-500 dark:text-gray-400">Manual steps on each endpoint.</div>
              </label>
              <label className={`p-4 rounded-xl cursor-pointer transition-all duration-200 ${automation === 'scripted-removal' ? 'bg-blue-100 dark:bg-blue-800 ring-2 ring-blue-500' : 'bg-white dark:bg-gray-600 hover:bg-gray-100 dark:hover:bg-gray-500'}`}>
                <input type="radio" name="automation" value="scripted-removal" checked={automation === 'scripted-removal'} onChange={e => setAutomation(e.target.value)} className="hidden" />
                <div className="font-medium">Scripted Removal</div>
                <div className="text-sm text-gray-500 dark:text-gray-400">Using scripts to automate the agent uninstallation process.</div>
              </label>
              <label className={`p-4 rounded-xl cursor-pointer transition-all duration-200 ${automation === 'full-automation' ? 'bg-blue-100 dark:bg-blue-800 ring-2 ring-blue-500' : 'bg-white dark:bg-gray-600 hover:bg-gray-100 dark:hover:bg-gray-500'}`}>
                <input type="radio" name="automation" value="full-automation" checked={automation === 'full-automation'} onChange={e => setAutomation(e.target.value)} className="hidden" />
                <div className="font-medium">Full Automation</div>
                <div className="text-sm text-gray-500 dark:text-gray-400">Integrating with a deployment tool like Intune for a seamless rollout.</div>
              </label>
            </div>
          </div>
        </section>

        {/* Results Section */}
        <div className="mt-8">
          <div className="p-6 bg-blue-700 dark:bg-blue-500 text-white rounded-2xl shadow-lg text-center">
            <h3 className="text-2xl sm:text-3xl font-bold">Estimated Effort:</h3>
            <p className="mt-2 text-5xl sm:text-6xl font-extrabold">{estimatedHours} hours</p>
            <p className="mt-2 text-sm sm:text-base">
              This is an initial estimate. The actual time may vary based on your environment's unique challenges.
            </p>
          </div>
        </div>

      </div>
    </div>
  );
};

export default App;
